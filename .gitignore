# Rendered outputs
*_files/
*.html
!templates/*.html

# Quarto cache
.quarto/
_freeze/

# Manim render intermediates (final movies live under media/ too)
media/
__pycache__/

# OS files
.DS_Store

# Packaged skill (regenerate with package_skill.py)
*.skill

# Local agent settings (personal overrides, not shared)
.claude/settings.local.json
.agents/settings.local.json

# Source PDFs from Canva (large binaries, not version-controlled)
reference_pdfs/

# Local FITS drop feeding the figure scripts (GB-scale binaries). The scripts
# that consume it are tracked, under scripts/figures/ — deleting this directory
# to reclaim the space must never take the tooling with it.
fits_files/

# Rendered deck exports (regenerate with decktape — see README)
*.pdf

# Talk-video build artifacts: slide PNGs, recorded/processed audio, muxed MP4.
# Scoped to the build areas — clips embedded in a deck (`<talk>/videos/*.webm|mp4`)
# must stay tracked. The narration scripts and spec.json under _video/<slug>/ are tracked too.
_video/*/slide-*.png
_video/*/*.mp4
_video/*/audio/
_video/*/out/
*.srt

/.quarto/

# Website project output
/_site/

**/*.quarto_ipynb
